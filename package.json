{
  "name": "horitieba",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "build:safari": "pnpm build && node scripts/build-safari.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile=artifacts/unit-results.json",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:real": "node scripts/e2e-real.mjs",
    "test:performance": "vitest run tests/performance",
    "package": "node scripts/report.mjs && prettier --write docs/test-report.md docs/evidence && node scripts/package.mjs",
    "check": "pnpm test && pnpm build && pnpm test:e2e && pnpm test:e2e:real && pnpm test:e2e:thread && pnpm test:e2e:forum",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "node scripts/report.mjs",
    "test:e2e:thread": "node scripts/e2e-thread-replies.mjs",
    "test:e2e:forum": "node scripts/e2e-forum.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.1.24",
    "@types/jsdom": "27.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
